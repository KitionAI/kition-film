{
  "name": "kition-film-ui",
  "version": "0.1.1",
  "private": true,
  "description": "The Film kit's own editor (Kition platform `docs/platform/kits/ui.md`), embedded by hosts over the Kit UI protocol.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "engine": "sh scripts/build-engine.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test 'src/**/*.test.mjs'",
    "test:parity": "node --test parity/check.test.mjs",
    "test:flow": "node tests/flow.mjs chromium && node tests/flow.mjs webkit",
    "test:modes": "node tests/modes.mjs chromium && node tests/modes.mjs webkit",
    "test:scenarios": "pnpm test:scenarios:1 && pnpm test:scenarios:2 && pnpm test:scenarios:3 && pnpm test:scenarios:4",
    "test:scenarios:1": "playwright test --shard=1/4",
    "test:scenarios:2": "playwright test --shard=2/4",
    "test:scenarios:3": "playwright test --shard=3/4",
    "test:scenarios:4": "playwright test --shard=4/4",
    "test:ci": "node scripts/test-ci.mjs",
    "test:ci:full": "node scripts/test-ci.mjs --full"
  },
  "dependencies": {
    "@kition/kit-dev-host": "^0.1.0",
    "@kition/kit-host": "^0.1.0",
    "@kition/kit-ui-protocol": "^0.1.0",
    "@kition/kit-editor": "^0.1.0",
    "@kition/tessera-icons": "^0.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "@kition/kdm": "^0.1.0",
    "@kition/kit-engine": "^0.1.0",
    "@kition/tessera-ui": "^0.1.0",
    "@kition/tessera-tokens": "^0.1.0",
    "loro-crdt": "1.16.4"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "1.59.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
